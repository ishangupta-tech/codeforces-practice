#include <iostream>
using namespace std;

const long long MOD = 1000000007LL;

int main() {
    long long x, y, n;
    cin >> x >> y >> n;

    long long f[6];
    f[0] = x;
    f[1] = y;
    f[2] = y - x;
    f[3] = -x;
    f[4] = -y;
    f[5] = x - y;

    long long ans = f[(n - 1) % 6];
    ans = (ans % MOD + MOD) % MOD;

    cout << ans << '\n';

    return 0;
}
