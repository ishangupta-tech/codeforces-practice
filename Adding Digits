#include <iostream>
using namespace std;

int main() {
    long long a, b, n;
    cin >> a >> b >> n;

    for (int digit = 0; digit <= 9; digit++) {
        if ((a * 10 + digit) % b == 0) {
            cout << a << digit;
            for (int i = 0; i < n - 1; i++) {
                cout << 0;
            }
            return 0;
        }
    }

    cout << -1;

    return 0;
}
