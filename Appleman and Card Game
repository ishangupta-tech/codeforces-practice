#include <iostream>
#include <algorithm>
#include <string>
using namespace std;

int main() {
    long long n, k;
    cin >> n >> k;

    string s;
    cin >> s;

    long long cnt[26] = {0};

    for (char c : s) {
        cnt[c - 'A']++;
    }

    sort(cnt, cnt + 26, greater<long long>());

    long long ans = 0;

    for (int i = 0; i < 26 && k > 0; i++) {
        long long take = min(cnt[i], k);
        ans += take * take;
        k -= take;
    }

    cout << ans << '\n';

    return 0;
}
