#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    vector<pair<int, int>> v(n);

    for (int i = 0; i < n; i++) {
        cin >> v[i].first >> v[i].second;
    }

    sort(v.begin(), v.end(), [](pair<int, int> a, pair<int, int> b) {
        if (a.first != b.first)
            return a.first > b.first;
        return a.second < b.second;
    });

    pair<int, int> target = v[k - 1];
    int ans = 0;

    for (int i = 0; i < n; i++) {
        if (v[i] == target)
            ans++;
    }

    cout << ans;

    return 0;
}
