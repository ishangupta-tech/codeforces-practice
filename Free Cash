#include <iostream>
#include <map>
using namespace std;

int main() {
    int n;
    cin >> n;

    map<pair<int, int>, int> mp;
    int ans = 0;

    for (int i = 0; i < n; i++) {
        int h, m;
        cin >> h >> m;

        mp[{h, m}]++;
        if (mp[{h, m}] > ans)
            ans = mp[{h, m}];
    }

    cout << ans;

    return 0;
}
