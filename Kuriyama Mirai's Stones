#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;

    long long a[100005], b[100005];
    long long pre1[100005] = {0};
    long long pre2[100005] = {0};

    for (int i = 1; i <= n; i++) {
        cin >> a[i];
        b[i] = a[i];
    }

    sort(b + 1, b + n + 1);

    for (int i = 1; i <= n; i++) {
        pre1[i] = pre1[i - 1] + a[i];
        pre2[i] = pre2[i - 1] + b[i];
    }

    int m;
    cin >> m;

    while (m--) {
        int type, l, r;
        cin >> type >> l >> r;

        if (type == 1) {
            cout << pre1[r] - pre1[l - 1] << '\n';
        } else {
            cout << pre2[r] - pre2[l - 1] << '\n';
        }
    }

    return 0;
}
