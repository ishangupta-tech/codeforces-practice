#include <iostream>
#include <set>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    int a[100005];
    int ans[100005];

    for (int i = 1; i <= n; i++) {
        cin >> a[i];
    }

    set<int> s;

    for (int i = n; i >= 1; i--) {
        s.insert(a[i]);
        ans[i] = s.size();
    }

    while (m--) {
        int l;
        cin >> l;
        cout << ans[l] << '\n';
    }

    return 0;
}
