#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> pos[5001];

    for (int i = 1; i <= 2 * n; i++) {
        int x;
        cin >> x;
        pos[x].push_back(i);
    }

    for (int i = 1; i <= 5000; i++) {
        if (pos[i].size() % 2) {
            cout << -1;
            return 0;
        }
    }

    for (int i = 1; i <= 5000; i++) {
        for (int j = 0; j < pos[i].size(); j += 2) {
            cout << pos[i][j] << " " << pos[i][j + 1] << '\n';
        }
    }

    return 0;
}
